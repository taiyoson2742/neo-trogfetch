#fancy text initialization
bold=$(tput bold)
normal=$(tput sgr0)
magenta=$(tput setaf 5)
orange=$(tput setaf 202)
yellow=$(tput setaf 11)
pink=$(tput setaf 206)
lightblue=$(tput setaf 33)
green=$(tput setaf 2)

#function to get uptime, uptime -p doesnt work on vms
get_uptime(){
	if [ -r /proc/uptime ]; then
		secs=$(cut -d. -f1 /proc/uptime)
	else
	    echo "unknown"
	    return
	fi
	
	d=$((secs / 86400))
	h=$((secs % 86400 / 3600))
	m=$((secs % 3600 / 60))
	
	out=""
	[ "$d" -gt 0 ] && out="${d}d "
	[ "$h" -gt 0 ] && out="${out}${h}h "
	echo "${out}${m}m"
}
#maps pci vendor if to a name when lspci is not installed (like on nix)
vendor_name(){
	case "$1" in
		0x10de) echo "NVIDIA" ;;
		0x1002|0x1022) echo "AMD" ;;
		0x8086) echo "Intel" ;;
		0x1af4) echo "Red Hat (virtio)" ;;
		0x15ad) echo "VMware" ;;
		0x80ee) echo "Oracle (VirtualBox)" ;;
		0x1234) echo "QEMU" ;;
		*) echo "$1" ;;
	esac
}

arch=$(lscpu | grep -w "Architecture:" | cut -c14-)

if [ $arch = aarch64 ]; then
	#echo "arm path"
	threads=$(lscpu | grep -w "Thread(s) per core:" | cut -c20-)
	cpc=$(lscpu | grep -w "Core(s) per cluster:" | cut -c21- | tr -d [:blank:])
	clusters=$(lscpu | grep -w "Cluster(s):" | cut -c12- | tr -d [:blank:])
	model=$(lscpu | grep -w "Model name:" | cut -c12- | grep 'w/' | cut -d "/" -f2)
	cores=$(($cpc*$clusters))
	mobo=$(tr -d '\0' < /sys/firmware/devicetree/base/model 2>/dev/null)

else
	#echo "default path"
	threads=$(lscpu | grep -w "Thread(s) per core:" | cut -c20-)
	cores=$(lscpu | grep -w "Core(s) per socket:" | cut -c20-)
	model=$(lscpu | grep -w "Model name:" | cut -c12- | grep 'w/' | cut -d "/" -f2)
	mobo=$(cat /sys/devices/virtual/dmi/id/board_{vendor,name,version} 2>/dev/null)

fi

#the part that actually displays the info
echo
echo "${bold}${magenta}---- General ----${normal}"
echo -e 'Name\t| ' $(uname -n)
echo -e 'Distro\t| ' $(grep -w 'PRETTY_NAME=' /etc/os-release | cut -c13- | tr -d '""' )
echo -e 'Kernal\t| ' $(uname -rs)
echo -e 'Uptime\t| ' "$(get_uptime)"
echo -e 'Mboard\t| ' $mobo

echo
echo -e "${bold}${orange}---- CPU ----${normal}"
echo -e 'Model\t| ' $(lscpu | grep -w "Model name:" | cut -c12-)
echo -e 'Brand\t| ' $(lscpu | grep -w "Vendor ID:" | cut -c11-)
echo -e 'Arch\t| ' $arch
echo -e 'Mode(s)\t| ' $(lscpu | grep -w "CPU op-mode(s):" | cut -c16-)
echo -e 'Speed\t| ' $(lscpu | grep -w "CPU max MHz" | cut -c13- | cut -d "." -f1)"MHz"
echo -e 'Cores\t| ' $cores
echo -e 'Threads\t| ' $(($threads*$cores)) 
echo
echo "${bold}${yellow}---- GPU ----${normal}"

if command -v lspci >/dev/null 2>&1; then
	gpu_brand=$(lspci -m | grep "VGA" | cut -d '"' -f8 | cut -d '/' -f2)
	if [ -n "$model" ]; then
		gpu_name=$model
	else
		gpu_name=$(lspci -m | grep 'VGA' | cut -d '"' -f6 | cut -d "[" -f2 | tr -d "]")
	fi
else
	#no lspci (e.g. NixOS without pciutils), fall back to sysfs.
	#this only gives vendor + PCI device id, not the marketing name.
	gpu_brand=""
	gpu_name=""
	for d in /sys/class/drm/card*/device; do
		[ -r "$d/vendor" ] || continue
		gpu_brand="$gpu_brand $(vendor_name "$(cat "$d/vendor")")"
		gpu_name="$gpu_name PCI:$(cat "$d/device" 2>/dev/null)"
	done
	[ -n "$model" ] && gpu_name=$model
fi

echo -e 'GPU(s)\t| ' ${gpu_name:-unknown}
echo -e 'Brand\t| ' ${gpu_brand:-unknown}
echo
echo "${bold}${pink}---- RAM ----${normal}"
echo -e 'Memory\t| ' $(free -h | grep "Mem:" | cut -c5- | tr -s [:blank:] | tr ' ' ':'  | cut -d ':' -f2)"B"
echo -e 'Used\t| ' $(free -h | grep "Mem:" | cut -c5- | tr -s [:blank:] | tr ' ' ':'  | cut -d ':' -f3)"B"
echo -e 'Free\t| ' $(free -h | grep "Mem:" | cut -c5- | tr -s [:blank:] | tr ' ' ':'  | cut -d ':' -f4)"B"
echo
echo "${bold}${lightblue}---- Swap ----${normal}"
echo -e 'Swap\t| ' $(free -h | grep "Swap:" | cut -c6- | tr -s [:blank:] | tr ' ' ':'  | cut -d ':' -f2)"B"
echo -e 'Free\t| ' $(free -h | grep "Swap:" | cut -c6- | tr -s [:blank:] | tr ' ' ':'  | cut -d ':' -f4)"B"
echo

if [ "$(uname -s)" = "Linux" ];
then
	echo "${bold}${lightblue}---- Disk(s) ----${normal}"
	df -h --output=target,size,used,avail -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs |  tail -n +2 | grep -Ev '^/(boot|nix/store)' |
	while read -r mount total used free
	do

		echo "${bold}${lightblue}${mount}${normal}"
		echo -e 'Total\t| '"${total}B"
		echo -e 'Used\t| '"${used}B"
		echo -e 'Free\t| '"${free}B"
	done
fi
echo
echo "${bold}${green}---- Network ----${normal}"
ipv4=$(ip -4 -o addr show scope global | awk '{print $4}' | cut -d/ -f1 | paste -sd ' ' -)
ipv6=$(ip -6 -o addr show scope global | awk '{print $4}' | cut -d/ -f1 | paste -sd ' ' -)
echo -e 'IPv4\t| ' "${ipv4:-none}"
echo -e 'IPv6\t| ' "${ipv6:-none}"
echo
